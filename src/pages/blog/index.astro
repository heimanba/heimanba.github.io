---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [featuredPost, ...restPosts] = posts;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(var(--site-max), calc(100% - (var(--site-gutter) * 2)));
				padding: 2rem 0 4.5rem;
			}
			.hero {
				display: grid;
				grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
				gap: 1rem;
				align-items: stretch;
				margin-bottom: 2rem;
			}
			.hero-copy,
			.featured-card,
			.post-card {
				padding: clamp(1.3rem, 2vw, 1.55rem);
			}
			.hero-copy p,
			.featured-card p,
			.post-card p {
				margin: 0;
			}
			.hero-copy {
				background:
					radial-gradient(circle at top right, rgba(214, 164, 141, 0.18), transparent 36%),
					rgba(var(--surface), 0.74);
			}
			.hero-copy p {
				max-width: 34rem;
				color: rgb(var(--gray));
			}
			.hero-stats {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 0.8rem;
				margin-top: 1.5rem;
				padding-top: 1.15rem;
				border-top: 1px solid rgba(162, 74, 47, 0.12);
			}
			.hero-stats strong,
			.hero-stats span {
				display: block;
			}
			.hero-stats strong {
				color: var(--accent-dark);
				font-size: 0.8rem;
				letter-spacing: 0.1em;
				text-transform: uppercase;
			}
			.hero-stats span {
				margin-top: 0.2rem;
				font-size: 0.96rem;
				color: rgb(var(--gray-dark));
				line-height: 1.55;
			}
			.featured-card {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				text-decoration: none;
				color: inherit;
				background:
					linear-gradient(180deg, rgba(252, 245, 237, 0.94), rgba(255, 252, 247, 0.8)),
					rgba(var(--surface), 0.74);
			}
			.featured-card,
			.post-card {
				position: relative;
				overflow: hidden;
			}
			.featured-card img {
				width: 100%;
				border-radius: 18px;
			}
			.featured-card h2 {
				margin: 0;
				font-size: clamp(1.9rem, 3vw, 2.6rem);
			}
			.featured-card .meta,
			.post-card .meta {
				font-size: 0.94rem;
				color: rgb(var(--gray));
			}
			.featured-card .description,
			.post-card .description {
				color: rgb(var(--gray-dark));
				line-height: 1.7;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1rem;
				padding-top: 2rem;
				border-top: 1px solid rgba(162, 74, 47, 0.12);
			}
			.post-card {
				display: flex;
				flex-direction: column;
				gap: 0.8rem;
				text-decoration: none;
				color: inherit;
				background: rgba(255, 252, 247, 0.74);
			}
			.post-card h3 {
				margin: 0;
				font-size: clamp(1.4rem, 2vw, 1.85rem);
				padding-right: 1.8rem;
			}
			.featured-card::before,
			.post-card::before {
				content: "↗";
				position: absolute;
				top: 1.15rem;
				right: 1.2rem;
				font-size: 1rem;
				color: rgba(162, 74, 47, 0.58);
				transition: transform var(--transition-soft), color var(--transition-soft);
			}
			.post-card:hover,
			.featured-card:hover {
				transform: translateY(-2px);
				box-shadow: var(--box-shadow-strong);
				border-color: var(--panel-border-strong);
			}
			.post-card:hover::before,
			.featured-card:hover::before {
				transform: translate(2px, -2px);
				color: var(--accent-dark);
			}
			@media (max-width: 900px) {
				.hero,
				.grid,
				.hero-stats {
					grid-template-columns: 1fr;
				}
			}
			@media (max-width: 720px) {
				main {
					padding-top: 1.2rem;
				}
				.hero {
					margin-bottom: 1.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-copy surface-panel">
					<div class="eyebrow">Archive</div>
					<h1>文章</h1>
					<p>这里优先放那些以后还想反复引用的内容。不是即时碎片，而是把判断、方法和项目过程整理成可复用的文字。</p>
					<div class="hero-stats">
						<div>
							<strong>内容取向</strong>
							<span>长期、可引用、可复盘。</span>
						</div>
						<div>
							<strong>关注主题</strong>
							<span>技术、产品、AI 与制作过程。</span>
						</div>
						<div>
							<strong>更新方式</strong>
							<span>慢一点，但尽量写完整。</span>
						</div>
					</div>
				</div>
				{
					featuredPost && (
						<a class="featured-card surface-panel" href={`/blog/${featuredPost.id}/`}>
							{featuredPost.data.heroImage && (
								<Image width={900} height={480} src={featuredPost.data.heroImage} alt="" />
							)}
							<div class="meta">
								<FormattedDate date={featuredPost.data.pubDate} />
							</div>
							<h2>{featuredPost.data.title}</h2>
							<p class="description">{featuredPost.data.description}</p>
						</a>
					)
				}
			</section>

			<section class="grid">
				{
					restPosts.map((post) => (
						<a class="post-card surface-panel" href={`/blog/${post.id}/`}>
							<div class="meta">
								<FormattedDate date={post.data.pubDate} />
							</div>
							<h3>{post.data.title}</h3>
							<p class="description">{post.data.description}</p>
						</a>
					))
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
