---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);

const works = (await getCollection('works'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.filter((work) => work.data.featured)
	.slice(0, 6);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="letter-intro">
				<p class="letter-intro__salutation">我是 {SITE_AUTHOR}。</p>
				<p class="letter-intro__lede">{SITE_DESCRIPTION}</p>
			</section>

			<section class="section section--posts">
				<h2>最新文章</h2>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li>
								<a class="post-item" href={`/blog/${post.id}/`}>
									<span class="post-title">{post.data.title}</span>
									<span class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<section class="section section--works">
				<h2>精选作品</h2>
				<ul class="post-list">
					{
						works.map((work) => (
							<li>
								<a class="post-item" href={`/works/${work.id}/`}>
									<span class="post-title">
										{work.data.title}
										{work.data.tags.length > 0 && (
											<span class="post-tags-inline">
												{work.data.tags.slice(0, 4).map((tag: string) => (
													<span class="post-tag">{tag}</span>
												))}
											</span>
										)}
									</span>
									<span class="post-date">
										<FormattedDate date={work.data.pubDate} />
										{work.data.role && (
											<span class="post-meta-inline"> · {work.data.role}</span>
										)}
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		width: min(var(--site-max), calc(100% - (var(--site-gutter) * 2)));
		margin: 0 auto;
		padding: var(--space-xl) 0 var(--space-2xl);
	}
	.letter-intro {
		max-width: 38rem;
		padding-bottom: var(--space-2xl);
	}
	.letter-intro__salutation {
		margin: 0 0 var(--space-md);
		font-family: var(--font-display);
		font-size: var(--text-display-s);
		font-weight: 700;
		letter-spacing: 0.01em;
		line-height: 1.25;
		color: var(--text-primary);
		text-wrap: balance;
	}
	.letter-intro__lede {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-xl);
		line-height: 1.6;
		color: var(--text-secondary);
		text-wrap: pretty;
	}
	.section--posts {
		margin-top: 0;
	}
	.section--works {
		margin-top: var(--space-3xl);
	}
	.section h2 {
		margin-bottom: var(--space-sm);
		font-size: var(--text-xl);
	}
	@media (max-width: 40rem) {
		.letter-intro__salutation {
			font-size: var(--text-2xl);
		}
		.letter-intro__lede {
			font-size: var(--text-lg);
		}
		.section--works {
			margin-top: var(--space-2xl);
		}
	}
</style>
