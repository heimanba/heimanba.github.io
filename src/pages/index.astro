---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);

const works = (await getCollection('works'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.filter((work) => work.data.featured)
	.slice(0, 4);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.home {
				width: min(1100px, calc(100% - 2rem));
				padding: 3rem 0 4rem;
			}
			.hero {
				padding: 2rem 0 3rem;
			}
			.hero h1 {
				max-width: 11ch;
				margin-bottom: 1rem;
				font-size: clamp(2.8rem, 7vw, 4.8rem);
				line-height: 1.05;
			}
			.hero p {
				max-width: 42rem;
				margin: 0;
				font-size: 1.1rem;
				color: rgb(var(--gray));
			}
			.section {
				padding: 2rem 0;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.section-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 1.25rem;
			}
			.section-head h2,
			.section-head p {
				margin: 0;
			}
			.section-head p {
				color: rgb(var(--gray));
				font-size: 0.98rem;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1rem;
			}
			.card {
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
				padding: 1.25rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: rgba(255, 255, 255, 0.86);
				text-decoration: none;
				color: inherit;
			}
			.card h3,
			.card p {
				margin: 0;
			}
			.meta {
				font-size: 0.95rem;
				color: rgb(var(--gray));
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}
			.tag {
				padding: 0.15rem 0.55rem;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				font-size: 0.82rem;
				color: rgb(var(--gray-dark));
			}
			.now-list {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1rem;
			}
			.now-item {
				padding: 1rem 0;
			}
			.now-item h3,
			.now-item p {
				margin: 0;
			}
			.now-item p {
				margin-top: 0.5rem;
				color: rgb(var(--gray));
				font-size: 0.98rem;
			}
			.card:hover {
				border-color: var(--accent);
				box-shadow: 0 8px 24px rgba(var(--gray), 12%);
			}
			@media (max-width: 820px) {
				.grid,
				.now-list {
					grid-template-columns: 1fr;
				}
				.section-head {
					flex-direction: column;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero">
				<h1>写文章，也把做过的东西摆出来。</h1>
				<p>
					这里是我的个人站。文章用来记录思考、技术和项目过程，作品用来展示已经做出来的产品、实验和长期项目。
				</p>
			</section>

			<section class="section">
				<div class="section-head">
					<h2>最新文章</h2>
					<p>按时间更新，适合持续阅读。</p>
				</div>
				<div class="grid">
					{
						posts.map((post) => (
							<a class="card" href={`/blog/${post.id}/`}>
								<div class="meta">
									<FormattedDate date={post.data.pubDate} />
								</div>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
							</a>
						))
					}
				</div>
			</section>

			<section class="section">
				<div class="section-head">
					<h2>精选作品</h2>
					<p>更偏结果、实现和能力证明。</p>
				</div>
				<div class="grid">
					{
						works.map((work) => (
							<a class="card" href={`/works/${work.id}/`}>
								<div class="meta">
									<FormattedDate date={work.data.pubDate} />
									{work.data.role && ` · ${work.data.role}`}
								</div>
								<h3>{work.data.title}</h3>
								<p>{work.data.description}</p>
								{work.data.tags.length > 0 && (
									<div class="tags">
										{work.data.tags.slice(0, 4).map((tag) => <span class="tag">{tag}</span>)}
									</div>
								)}
							</a>
						))
					}
				</div>
			</section>

			<section class="section">
				<div class="section-head">
					<h2>现在在做</h2>
					<p>让首页不只是归档页，也保留一点进行中的状态。</p>
				</div>
				<div class="now-list">
					<div class="now-item">
						<h3>写长期内容</h3>
						<p>把零散想法收束成文章，积累成能反复引用的输出。</p>
					</div>
					<div class="now-item">
						<h3>做小而完整的作品</h3>
						<p>不只展示想法，更展示交付结果、链接和复盘。</p>
					</div>
					<div class="now-item">
						<h3>维护这个站</h3>
						<p>让它同时承担目录、档案和个人入口三种角色。</p>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
