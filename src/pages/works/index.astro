---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const works = (await getCollection('works')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`作品 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(1100px, calc(100% - 2rem));
				padding: 3rem 0 4rem;
			}
			.hero {
				padding-bottom: 2rem;
			}
			.hero h1,
			.hero p {
				margin: 0;
			}
			.hero p {
				margin-top: 0.75rem;
				max-width: 42rem;
				color: rgb(var(--gray));
			}
			.list {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1rem;
				padding-top: 2rem;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.card {
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
				padding: 1.25rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: rgba(255, 255, 255, 0.86);
				text-decoration: none;
				color: inherit;
			}
			.card h2,
			.card p {
				margin: 0;
			}
			.meta {
				font-size: 0.95rem;
				color: rgb(var(--gray));
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}
			.tag {
				padding: 0.15rem 0.55rem;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				font-size: 0.82rem;
			}
			.card:hover {
				border-color: var(--accent);
				box-shadow: 0 8px 24px rgba(var(--gray), 12%);
			}
			@media (max-width: 820px) {
				.list {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>作品</h1>
				<p>这里放已经做出来的东西，包括网站、工具、实验和长期项目。每个条目都尽量说明目标、角色、结果和链接。</p>
			</section>

			<section class="list">
				{
					works.map((work) => (
						<a class="card" href={`/works/${work.id}/`}>
							<div class="meta">
								<FormattedDate date={work.data.pubDate} />
								{work.data.role && ` · ${work.data.role}`}
								{work.data.status && ` · ${work.data.status}`}
							</div>
							<h2>{work.data.title}</h2>
							<p>{work.data.description}</p>
							{work.data.tags.length > 0 && (
								<div class="tags">
									{work.data.tags.map((tag) => <span class="tag">{tag}</span>)}
								</div>
							)}
						</a>
					))
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
