---
import { SITE_AUTHOR } from '../consts';

const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} {SITE_AUTHOR}. Powered by Astro and GitHub Pages.
</footer>
<style>
	footer {
		padding: 2.5rem 1rem 5rem;
		border-top: 1px solid rgba(var(--gray), 0.12);
		background: transparent;
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.95rem;
	}
</style>
