---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="主导航">
		<h2 class="brand"><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/works">作品</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 var(--site-gutter);
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgba(255, 252, 247, 0.88);
		backdrop-filter: blur(14px);
		border-bottom: 1px solid rgba(var(--gray), 0.14);
		box-shadow: 0 8px 24px rgba(50, 35, 20, 0.04);
	}
	.brand {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.32rem;
		letter-spacing: -0.03em;
		line-height: 1;
	}
	.brand a,
	.brand a.active {
		text-decoration: none;
		color: rgb(var(--black));
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 1100px;
		margin: 0 auto;
		padding: 0.8rem 0;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		overflow-x: auto;
		scrollbar-width: none;
		white-space: nowrap;
	}
	.internal-links::-webkit-scrollbar {
		display: none;
	}
	nav a {
		padding: 0.3rem 0;
		color: rgb(var(--gray-dark));
		font-size: 0.96rem;
		text-decoration: none;
		border-bottom: 2px solid transparent;
		transition: color 180ms ease, border-color 180ms ease;
	}
	nav a:hover {
		color: rgb(var(--black));
		border-color: rgba(var(--gray), 0.32);
	}
	nav a.active {
		color: rgb(var(--black));
		border-color: var(--accent);
	}
	@media (max-width: 720px) {
		nav {
			flex-direction: column;
			align-items: stretch;
			gap: 0.55rem;
			padding: 0.65rem 0;
		}
		.brand {
			font-size: 1.22rem;
		}
		.internal-links {
			padding-bottom: 0.05rem;
		}
		nav a {
			padding: 0.28rem 0;
		}
	}
</style>
