---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'works'>['data'];

const {
	title,
	description,
	pubDate,
	updatedDate,
	coverImage,
	tags = [],
	role,
	status,
	links,
} = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: min(1080px, calc(100% - (var(--site-gutter) * 2)));
				padding: 2rem 0 4.5rem;
			}
			.hero {
				display: grid;
				grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr);
				gap: 1.4rem;
				padding-bottom: 2.25rem;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.hero h1,
			.hero p {
				margin: 0;
			}
			.hero h1 {
				font-family: var(--font-serif);
				font-size: clamp(2.2rem, 4.8vw, 4.25rem);
				font-weight: 700;
				letter-spacing: -0.015em;
				line-height: 1.1;
				text-wrap: pretty;
			}
			.lead {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				padding: clamp(1.2rem, 2vw, 1.55rem);
				border: 1px solid var(--panel-border);
				border-radius: 24px;
				background:
					radial-gradient(circle at top right, rgba(214, 164, 141, 0.18), transparent 40%),
					rgba(var(--surface), 0.76);
				box-shadow: var(--box-shadow);
			}
			.lead p {
				font-family: var(--font-serif);
				color: rgb(var(--gray-dark));
				line-height: 1.65;
			}
			.meta {
				font-family: var(--font-ui);
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			.panel {
				padding: 1.3rem;
				border: 1px solid var(--panel-border);
				border-radius: 20px;
				background: rgba(var(--surface-soft), 0.76);
				box-shadow: 0 14px 34px rgba(50, 35, 20, 0.05);
				align-self: start;
				position: sticky;
				top: 6.2rem;
				font-family: var(--font-ui);
			}
			.panel h2 {
				margin-bottom: 0.9rem;
				font-size: 1.15rem;
				font-family: var(--font-ui);
			}
			.panel ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.panel li + li {
				margin-top: 0.75rem;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}
			.tag {
				padding: 0.15rem 0.55rem;
				border-radius: 999px;
				background: rgba(var(--gray-light), 0.8);
				font-size: 0.82rem;
			}
			.cover {
				margin: 2.5rem 0 2rem;
			}
			.cover img {
				display: block;
				width: 100%;
				border-radius: 8px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: min(680px, 100%);
				margin: 0 auto;
			}
			@media (max-width: 860px) {
				.hero {
					grid-template-columns: 1fr;
				}
				.panel {
					position: static;
				}
			}
			@media (max-width: 720px) {
				main {
					padding-top: 1.2rem;
				}
				.hero {
					padding-bottom: 1.6rem;
				}
				.hero h1 {
					font-size: clamp(1.9rem, 8.4vw, 3rem);
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="lead">
					<div class="meta">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<>
								{' '}
								· 最后更新于 <FormattedDate date={updatedDate} />
							</>
						)}
					</div>
					<h1>{title}</h1>
					<p>{description}</p>
					{tags.length > 0 && (
						<div class="tags">
							{tags.map((tag) => <span class="tag">{tag}</span>)}
						</div>
					)}
				</div>

				<aside class="panel">
					<h2>项目信息</h2>
					<ul>
						{role && <li><strong>角色</strong><br />{role}</li>}
						{status && <li><strong>状态</strong><br />{status}</li>}
						{links?.demo && (
							<li>
								<strong>在线体验</strong><br />
								<a href={links.demo}>打开链接</a>
							</li>
						)}
						{links?.repo && (
							<li>
								<strong>代码仓库</strong><br />
								<a href={links.repo}>查看 GitHub</a>
							</li>
						)}
						{links?.article && (
							<li>
								<strong>相关文章</strong><br />
								<a href={links.article}>阅读复盘</a>
							</li>
						)}
					</ul>
				</aside>
			</section>

			{coverImage && (
				<div class="cover">
					<Image width={1400} src={coverImage} alt="" />
				</div>
			)}

			<article class="prose">
				<slot />
			</article>
		</main>
		<Footer />
	</body>
</html>
