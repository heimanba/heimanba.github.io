---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'works'>['data'];

const {
	title,
	description,
	pubDate,
	updatedDate,
	coverImage,
	tags = [],
	role,
	status,
	links,
} = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: min(1080px, calc(100% - 2rem));
				padding: 2.5rem 0 4rem;
			}
			.hero {
				display: grid;
				grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr);
				gap: 2rem;
				padding-bottom: 2rem;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.hero h1,
			.hero p {
				margin: 0;
			}
			.lead {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}
			.meta {
				color: rgb(var(--gray));
			}
			.panel {
				padding: 1.25rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: rgba(255, 255, 255, 0.86);
			}
			.panel h2 {
				margin-bottom: 0.75rem;
				font-size: 1.1rem;
			}
			.panel ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.panel li + li {
				margin-top: 0.75rem;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}
			.tag {
				padding: 0.15rem 0.55rem;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				font-size: 0.82rem;
			}
			.cover {
				margin: 2rem 0;
			}
			.cover img {
				display: block;
				width: 100%;
				border-radius: 8px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: min(760px, 100%);
			}
			@media (max-width: 860px) {
				.hero {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="lead">
					<div class="meta">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<>
								{' '}
								· 最后更新于 <FormattedDate date={updatedDate} />
							</>
						)}
					</div>
					<h1>{title}</h1>
					<p>{description}</p>
					{tags.length > 0 && (
						<div class="tags">
							{tags.map((tag) => <span class="tag">{tag}</span>)}
						</div>
					)}
				</div>

				<aside class="panel">
					<h2>项目信息</h2>
					<ul>
						{role && <li><strong>角色</strong><br />{role}</li>}
						{status && <li><strong>状态</strong><br />{status}</li>}
						{links?.demo && (
							<li>
								<strong>在线体验</strong><br />
								<a href={links.demo}>打开链接</a>
							</li>
						)}
						{links?.repo && (
							<li>
								<strong>代码仓库</strong><br />
								<a href={links.repo}>查看 GitHub</a>
							</li>
						)}
						{links?.article && (
							<li>
								<strong>相关文章</strong><br />
								<a href={links.article}>阅读复盘</a>
							</li>
						)}
					</ul>
				</aside>
			</section>

			{coverImage && (
				<div class="cover">
					<Image width={1400} src={coverImage} alt="" />
				</div>
			)}

			<article class="prose">
				<slot />
			</article>
		</main>
		<Footer />
	</body>
</html>
