---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_AUTHOR } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: min(680px, calc(100% - (var(--site-gutter) * 2)));
				margin: 0 auto;
				padding: clamp(2rem, 2.8vw, 3.5rem) 0 4.5rem;
			}
			.top-nav {
				font-family: var(--font-ui);
				font-size: 13px;
				color: var(--text-tertiary);
				margin-bottom: 3.5rem;
			}
			.top-nav a {
				color: inherit;
				text-decoration: none;
				transition: color var(--transition-soft);
			}
			.top-nav a:hover {
				color: var(--accent);
			}
			.eyebrow {
				font-family: var(--font-ui);
				font-size: 12px;
				text-transform: uppercase;
				letter-spacing: 0.14em;
				font-weight: 600;
				color: var(--accent);
				margin-bottom: 14px;
			}
			.title-area h1 {
				margin: 0 0 20px;
				font-family: var(--font-body);
				font-size: clamp(2rem, 4.5vw, 2.75rem);
				line-height: 1.15;
				letter-spacing: -0.028em;
				font-weight: 700;
				text-wrap: pretty;
			}
			.byline {
				font-family: var(--font-ui);
				font-size: 14px;
				color: var(--text-tertiary);
				margin: 0 0 2.5rem;
				display: flex;
				align-items: center;
				gap: 12px;
			}
			.lede {
				font-size: 1.25rem;
				line-height: 1.55;
				color: var(--text-secondary);
				margin: 0 0 2.5rem;
			}
			.hero-image {
				width: 100%;
				aspect-ratio: 16/9;
				margin-bottom: 3rem;
				border-radius: var(--radius-md);
				overflow: hidden;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			.prose {
				width: 100%;
				padding: 0.5rem 0 0;
				color: var(--text-secondary);
			}
			@media (max-width: 720px) {
				.title-area h1 {
					font-size: clamp(1.85rem, 8.4vw, 2.5rem);
				}
				.lede {
					font-size: 1.12rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<nav class="top-nav">
					<a href="/blog/">← 文章</a>
				</nav>
				<div class="title-area">
					<h1>{title}</h1>
					<div class="byline">
						<span>By {SITE_AUTHOR} · <FormattedDate date={pubDate} />{updatedDate && <> · 更新于 <FormattedDate date={updatedDate} /></>}</span>
					</div>
					{description && <p class="lede">{description}</p>}
				</div>
				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
